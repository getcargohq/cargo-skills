{
  "name": "cargo",
  "displayName": "Cargo GTM (cargo-ai)",
  "description": "Cargo GTM (cargo-ai), the go-to-market platform, in Claude Code. Not Rust's cargo. 19 skills over the cargo-ai CLI, plus the hosted MCP server: target lists, contact enrichment and verification from licensed data providers, lead scoring, CRM sync, signal monitoring, orchestration, storage, segments, CDK, diagnostics, plus prompt-free approval for safe cargo-ai calls.",
  "version": "1.27.2",
  "author": { "name": "getcargo" },
  "homepage": "https://github.com/getcargohq/cargo-skills",
  "skills": ["./"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/approve-cli.sh claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-checkpoint.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-end.sh"
          }
        ]
      }
    ]
  }
}
